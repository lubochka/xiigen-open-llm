{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private operator native-reference corpus intake (fields and types only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpusName",
    "corpusVersion",
    "frozenAtUtc",
    "subject",
    "capture",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "xiigen.native-reference-corpus-intake.v1"
    },
    "corpusName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "frozenAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "runtimeVersion",
        "captureBoundary",
        "requestedModelAlias",
        "requestedReasoningEffort",
        "threadId",
        "observedProviderId",
        "observedModelId",
        "observedModelVersion",
        "observedServerRequestId",
        "requestRawUtf8Sha256",
        "responseRawUtf8Sha256",
        "stdoutSha256",
        "stderrSha256",
        "captureRecordSha256",
        "startedAtUtc",
        "capturedAtUtc",
        "inputTokens",
        "outputTokens",
        "reasoningTokens"
      ],
      "properties": {
        "runtimeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "captureBoundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "requestedModelAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "requestedReasoningEffort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "observedProviderId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "observedModelId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "observedModelVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "observedServerRequestId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "requestRawUtf8Sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "responseRawUtf8Sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stdoutSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stderrSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "captureRecordSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "startedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"
        },
        "capturedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "reasoningTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "ownerInput",
          "referenceAnswer",
          "partition",
          "sourceEntityFingerprint",
          "ownerInputRawUtf8Sha256",
          "referenceAnswerRawUtf8Sha256"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "ownerInput": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "referenceAnswer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "partition": {
            "enum": [
              "train",
              "held-out"
            ]
          },
          "sourceEntityFingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "ownerInputRawUtf8Sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "referenceAnswerRawUtf8Sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
