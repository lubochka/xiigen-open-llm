<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows Forms is the simplest desktop UI framework built into .NET; no XAML needed. -->
    <OutputType>WinExe</OutputType>
    <!-- Targeting the Windows-specific .NET TFM so we can use System.Windows.Forms types. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- Enable the Windows Forms designer types and the high-DPI defaults. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentInfrastructure.Desktop</RootNamespace>
    <AssemblyName>AgentInfrastructure.Desktop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the class library that holds all the agent-stage logic. -->
    <ProjectReference Include="..\21.AgentInfrastructure\AgentInfrastructure.csproj" />
  </ItemGroup>

</Project>
