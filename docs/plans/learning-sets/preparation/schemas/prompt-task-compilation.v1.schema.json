{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_id",
    "task",
    "missing"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "missing": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "missing": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "missing": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
