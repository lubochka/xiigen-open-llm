{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XIIGEN candidate DPO row, creation stage only",
  "description": "One JSON object per JSONL line. Structural conformance does not establish semantic quality, native admission or learning. Request-specific family/topic constraints are checked by batches.py finish.",
  "type": "object",
  "required": ["schema_version", "pair_id", "domain_id", "topic_id", "profile_id", "family_id", "split", "prompt", "chosen", "rejected", "error_tag", "rationale", "source_refs", "provenance", "metadata"],
  "properties": {
    "schema_version": {"const": "xiigen.dpo.v1"},
    "pair_id": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "exam"]},
    "prompt": {"type": "string", "minLength": 1},
    "chosen": {"type": "string", "minLength": 1},
    "rejected": {"type": "string", "minLength": 1},
    "error_tag": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object", "required": ["kind", "generator_model"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "generator_model": {"type": "string", "minLength": 1},
        "generation_session_id": {"type": "string"},
        "surface": {"type": "string"},
        "model_identity_observed": {"type": "boolean"}
      }
    },
    "metadata": {
      "type": "object", "required": ["origin_family_id", "leakage_group_ids"],
      "properties": {
        "origin_family_id": {"type": "string", "minLength": 1},
        "leakage_group_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "learning_objective_id": {"type": "string", "minLength": 1},
        "review_status": {"type": "string"},
        "simulation": {"type": "boolean"},
        "measured_training_result": {"const": false}
      }
    }
  }
}
