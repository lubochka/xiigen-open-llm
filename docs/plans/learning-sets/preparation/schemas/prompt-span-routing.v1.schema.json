{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segments",
    "clarify"
  ],
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "domain_id",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "clarify": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "missing"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "missing": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Structural learner output only. Exact substrings, catalog meaning, dependency existence/acyclicity and context preservation require the assigned authoring checks, not a schema-pass claim."
}
