        },
        "rollback_evidence": {
          "type": "string"
        },
        "dpo_pair_evidence": {
          "type": "string"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "asset_lifecycle_payload": {
      "type": "object",
      "required": [
        "backup_export_import",
        "share",
        "continue_training",
        "rollback",
        "package_manifest",
        "readback_evidence",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "backup_export_import": {
          "type": "string"
        },
        "share": {
          "type": "string"
        },
        "continue_training": {
          "type": "string"
        },
        "rollback": {
          "type": "string"
        },
        "package_manifest": {
          "type": "string"
        },
        "readback_evidence": {
          "type": "string"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "checkpoint_payload": {
      "type": "object",
      "required": [
        "candidate_hash",
        "compatibility_load_result",
        "quality_gate",
        "promotion_owner",
        "rollback_evidence",
        "host_reload_evidence",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "candidate_hash": {
          "type": "string"
        },
        "compatibility_load_result": {
          "type": "string"
        },
        "quality_gate": {
          "type": "string"
        },
        "promotion_owner": {
          "type": "string"
        },
        "rollback_evidence": {
          "type": "string"
        },
        "host_reload_evidence": {
          "type": "string"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "locator_payload": {
      "type": "object",
      "required": [
        "locator_source_of_truth",
        "locator_diff",
        "fresh_load_result",
        "rollback_locator",
        "per_host_reload_evidence",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "locator_source_of_truth": {
          "type": "string"
        },
        "locator_diff": {
          "type": "string"
        },
        "fresh_load_result": {
          "type": "string"
        },
        "rollback_locator": {
          "type": "string"
        },
        "per_host_reload_evidence": {
          "type": "string"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "codex_chat_ui_payload": {
      "type": "object",
      "required": [
        "activation",
        "visible_marker",
        "screenshot_video_log_evidence",
        "helper_vs_real_ui_separation",
        "exact_blocker_if_unavailable",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "activation": {
          "type": "string"
        },
        "visible_marker": {
          "type": "string"
        },
        "screenshot_video_log_evidence": {
          "type": "string"
        },
        "helper_vs_real_ui_separation": {
          "type": "string"
        },
        "exact_blocker_if_unavailable": {
          "type": "string"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "typed_payloads": {
      "type": "object",
      "properties": {
        "token": {
          "$ref": "#/$defs/token_payload"
        },
        "semantic_quality": {
          "$ref": "#/$defs/semantic_quality_payload"
        },
        "learnability_dpo": {
          "$ref": "#/$defs/learnability_dpo_payload"
        },
        "asset_lifecycle": {
          "$ref": "#/$defs/asset_lifecycle_payload"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint_payload"
        },
        "locator": {
          "$ref": "#/$defs/locator_payload"
        },
        "codex_chat_ui": {
          "$ref": "#/$defs/codex_chat_ui_payload"
        }
      },
      "additionalProperties": false
    },
    "typed_payload_conditionals": {
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "token-savings"
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "semantic-quality"
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "semantic_quality"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "enum": [
                  "learnability-training",
                  "dpo-quality"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "learnability_dpo"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "asset-lifecycle"
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "asset_lifecycle"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "checkpoint-promotion"
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "checkpoint"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "locator-update"
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "locator"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "codex-chat-ui"
              }
            }
          },
          "then": {
            "properties": {
              "typed_payloads": {
                "required": [
                  "codex_chat_ui"
                ]
              }
            }
          }
        }
      ]
    },
    "base_properties": {
      "schema_version": {
        "$ref": "#/$defs/schema_version"
      },
      "phase": {
        "$ref": "#/$defs/phase"
      },
      "scenario_id": {
        "type": "string",
        "minLength": 1
      },
      "host": {
        "$ref": "#/$defs/host"
      },
      "claim_id": {
        "$ref": "#/$defs/claim_id"
      },
      "marker": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "$ref": "#/$defs/evidence_list"
      },
      "remaining": {
        "$ref": "#/$defs/string_list"
      },
      "downgraded_claim": {
        "type": "string",
        "minLength": 1
      },
      "non_claims": {
