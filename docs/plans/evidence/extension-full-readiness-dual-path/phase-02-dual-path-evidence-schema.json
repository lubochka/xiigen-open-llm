{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiigen.local/schemas/phase-02-dual-path-evidence-schema.json",
  "title": "Phase 02 Dual-Path Evidence Contract",
  "description": "Schema-style contract for Automated boundary packet, Local desktop packet, and joined evidence packet. Defaults are intentionally forbidden by the local validator.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/automated_boundary_packet"
    },
    {
      "$ref": "#/$defs/local_desktop_packet"
    },
    {
      "$ref": "#/$defs/joined_evidence_packet"
    }
  ],
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "phase-02-dual-path-evidence-contract/v1"
    },
    "phase": {
      "type": "string",
      "const": "Phase 02"
    },
    "host": {
      "type": "string",
      "enum": [
        "Claude",
        "Cursor",
        "Codex"
      ]
    },
    "claim_id": {
      "type": "string",
      "enum": [
        "product-readiness",
        "full-extension",
        "codex-chat-ui",
        "token-savings",
        "semantic-quality",
        "learnability-training",
        "dpo-quality",
        "asset-lifecycle",
        "checkpoint-promotion",
        "locator-update"
      ]
    },
    "redaction_status": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "PENDING_REDACTION",
        "REDACTED",
        "REDACTION_NOT_REQUIRED"
      ]
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "collected_by",
        "collected_at_utc_or_NONE",
        "source",
        "command_or_NONE",
        "input_refs",
        "notes"
      ],
      "properties": {
        "collected_by": {
          "type": "string",
          "minLength": 1
        },
        "collected_at_utc_or_NONE": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "command_or_NONE": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "$ref": "#/$defs/string_list"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_item": {
      "type": "object",
      "required": [
        "evidence_type",
        "status",
        "artifact_ref_or_NONE",
        "summary",
        "redaction_status",
        "provenance"
      ],
      "properties": {
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "For any path PASS, PASS_JOINED, or joined_claim_proven=true, evidence status must be COLLECTED or ACCEPTED. Placeholder statuses such as NOT_RUN, NOT_CAPTURED, NEEDS_VERIFICATION, and NOT_DISCOVERED_YET are shape-only non-claims and cannot support PASS.",
          "type": "string",
          "enum": [
            "NOT_RUN",
            "NEEDS_VERIFICATION",
            "NOT_CAPTURED",
            "COLLECTED",
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "artifact_ref_or_NONE": {
          "description": "For PASS evidence this must reference a real collected artifact. NONE, NONE_COLLECTED_IN_PHASE_01_01, NONE_COLLECTED_IN_PHASE_02_SAMPLE, and other placeholder refs are allowed only for non-PASS shape samples.",
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "redaction_status": {
          "$ref": "#/$defs/redaction_status"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "claims_substitute_for_path": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "automated_boundary": {
      "type": "object",
      "required": [
        "status",
        "evidence",
        "remaining",
        "blocker_or_NONE",
        "downgraded_claim",
        "provenance"
      ],
      "properties": {
        "status": {
          "description": "PASS_AUTOMATED_BOUNDARY requires real COLLECTED or ACCEPTED Automated boundary evidence, a non-placeholder artifact ref, no blocker, and no downgrade text contradicting PASS.",
          "type": "string",
          "enum": [
            "NOT_RUN",
            "NEEDS_VERIFICATION",
            "PASS_AUTOMATED_BOUNDARY",
            "BLOCKED_AUTOMATED_BOUNDARY",
            "FAIL"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "blocker_or_NONE": {
          "type": "string",
          "minLength": 1
        },
        "downgraded_claim": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "local_desktop": {
      "type": "object",
      "required": [
        "status",
        "activation",
        "evidence",
        "remaining",
        "blocker_or_NONE",
        "downgraded_claim",
        "provenance"
      ],
      "properties": {
        "status": {
          "description": "PASS_LOCAL_DESKTOP requires real COLLECTED or ACCEPTED Local desktop evidence, real activation evidence, a non-placeholder artifact ref, no blocker, and no downgrade text contradicting PASS.",
          "type": "string",
          "enum": [
            "NOT_RUN",
            "NEEDS_VERIFICATION",
            "PASS_LOCAL_DESKTOP",
            "BLOCKED_LOCAL_UI_CONTROL",
            "BLOCKED_HOST_NOT_INSTALLED",
            "BLOCKED_LOCAL_DESKTOP",
            "FAIL"
          ]
        },
        "activation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "blocker_or_NONE": {
          "type": "string",
          "minLength": 1
        },
        "downgraded_claim": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "result_fields": {
      "type": "object",
      "required": [
        "evidence",
        "remaining",
        "downgraded_claim",
        "non_claims",
        "blocker_or_NONE",
        "redaction_status",
        "provenance"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string",
          "minLength": 1
        },
        "non_claims": {
          "$ref": "#/$defs/string_list"
        },
        "blocker_or_NONE": {
          "type": "string",
          "minLength": 1
        },
        "redaction_status": {
          "$ref": "#/$defs/redaction_status"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "token_payload": {
      "type": "object",
      "required": [
        "workload_id",
        "tokenizer",
        "tokenizer_version",
        "baseline_tokens",
        "candidate_tokens",
        "repeat_count",
        "savings_calculation",
        "quality_guard",
        "evidence",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "workload_id": {
          "type": "string"
        },
        "tokenizer": {
          "type": "string"
        },
        "tokenizer_version": {
          "type": "string"
        },
        "baseline_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "candidate_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "repeat_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "savings_calculation": {
          "type": "string"
        },
        "quality_guard": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/string_list"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "semantic_quality_payload": {
      "type": "object",
      "required": [
        "held_out_case_id",
        "rubric",
        "baseline_score",
        "candidate_score",
        "leakage_checks",
        "answer_evidence",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "held_out_case_id": {
          "type": "string"
        },
        "rubric": {
          "type": "string"
        },
        "baseline_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "candidate_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "leakage_checks": {
          "type": "string"
        },
        "answer_evidence": {
          "type": "string"
        },
        "remaining": {
          "$ref": "#/$defs/string_list"
        },
        "downgraded_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "learnability_dpo_payload": {
      "type": "object",
      "required": [
        "dataset_provenance",
        "allowed_use_status",
        "train_eval_split",
        "leakage_gates",
        "before_after_behavior",
        "checkpoint_diff",
        "rollback_evidence",
        "dpo_pair_evidence",
        "remaining",
        "downgraded_claim"
      ],
      "properties": {
        "dataset_provenance": {
          "type": "string"
        },
        "allowed_use_status": {
