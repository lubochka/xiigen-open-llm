    "joined_evidence_packet": {
      "allOf": [
        {
          "$ref": "#/$defs/typed_payload_conditionals"
        },
        {
          "type": "object",
          "required": [
            "packet_kind",
            "schema_version",
            "phase",
            "scenario_id",
            "host",
            "claim_id",
