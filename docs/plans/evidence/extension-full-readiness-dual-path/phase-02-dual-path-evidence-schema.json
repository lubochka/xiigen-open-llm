      },
      "typed_payloads": {
        "$ref": "#/$defs/typed_payloads"
      }
    },
    "base_required": [
      "schema_version",
      "phase",
      "scenario_id",
      "host",
      "claim_id",
      "marker",
      "evidence",
      "remaining",
      "downgraded_claim",
