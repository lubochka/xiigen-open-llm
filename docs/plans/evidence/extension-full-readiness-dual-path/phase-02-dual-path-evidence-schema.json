    "local_desktop_packet": {
      "allOf": [
        {
          "$ref": "#/$defs/typed_payload_conditionals"
        },
        {
          "type": "object",
          "required": [
            "packet_kind",
            "local_desktop",
            "schema_version",
            "phase",
            "scenario_id",
            "host",
            "claim_id",
            "marker",
            "evidence",
