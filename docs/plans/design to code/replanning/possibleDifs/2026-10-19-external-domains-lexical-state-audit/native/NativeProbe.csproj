<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <Target Name="RequireCoreRepo" BeforeTargets="PrepareForBuild" Condition="'$(CoreRepo)' == ''">
    <Error Text="Pass -p:CoreRepo=ABSOLUTE_PATH_TO_DISPOSABLE_PINNED_LLM_MVP_CORE_CHECKOUT" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(CoreRepo)/12.SemanticCompiler/SemanticCompiler.csproj" />
  </ItemGroup>
</Project>
