{"pair_id": "translator-en-ru-general-batch-018-heldout-0022", "stream_id": "translator-en-ru-general", "batch_index": 18, "pair_family": "T01", "source_text": "The surgery was a success.", "chosen": "Операция прошла успешно.", "rejected": "Хирургия была успехом.", "defect_type": "false_friend", "defect_annotation": "[WRONG: false_friend - хирургия means surgery as a field; операция is correct for a surgical procedure]", "source_id": "TR-S01", "source_license_state": "ACCEPT", "direction": "EN_RU", "topic_domain": "general", "topic_label": "health_body", "register": "neutral", "risk_class": "normal", "translation_level": 1, "adapter_id": "adapter-en-ru-general", "split": "heldout", "routing_labels": {"direction": "EN_RU", "topic_domain": "general", "register": "neutral", "risk_class": "normal", "translation_level": 1, "adapter_id": "adapter-en-ru-general"}}
