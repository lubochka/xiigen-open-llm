{"pair_id": "translator-en-ru-general-batch-018-heldout-0020", "stream_id": "translator-en-ru-general", "batch_index": 18, "pair_family": "T01", "source_text": "He takes vitamins every morning.", "chosen": "Он принимает витамины каждое утро.", "rejected": "Он берёт витамины каждое утро.", "defect_type": "wrong_word_choice", "defect_annotation": "[WRONG: wrong_word_choice - брать means to take physically; принимать is the correct verb for taking vitamins or medication]", "source_id": "TR-S01", "source_license_state": "ACCEPT", "direction": "EN_RU", "topic_domain": "general", "topic_label": "health_body", "register": "neutral", "risk_class": "normal", "translation_level": 1, "adapter_id": "adapter-en-ru-general", "split": "heldout", "routing_labels": {"direction": "EN_RU", "topic_domain": "general", "register": "neutral", "risk_class": "normal", "translation_level": 1, "adapter_id": "adapter-en-ru-general"}}
