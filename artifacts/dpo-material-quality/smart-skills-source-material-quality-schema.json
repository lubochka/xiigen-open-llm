{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smart-skills-source-material-quality-audit-schema-v1",
  "title": "Smart Skills Source Material Quality Audit",
  "type": "object",
  "required": [
    "artifact",
    "status",
    "work_order_id",
    "training_block",
    "category_definitions",
    "sample_strategy",
    "counts",
    "universalization_rule"
  ],
  "properties": {
    "artifact": {
      "const": "smart-skills-source-material-quality-audit"
    },
    "status": {
      "enum": [
        "PASS_Q2_00_AUDIT_ONLY",
        "FAIL_REPAIR_REQUIRED"
      ]
    },
    "work_order_id": {
      "const": "Q2-00"
    },
    "training_block": {
      "type": "object",
      "required": [
        "training_allowed",
        "blocked_until",
        "reason"
      ],
      "properties": {
        "training_allowed": {
          "const": false
        },
        "blocked_until": {
          "const": "Q2 material-quality review PASS"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "category_definitions": {
      "type": "object"
    },
    "sample_strategy": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "universalization_rule": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
