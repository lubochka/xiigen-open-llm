<Project Sdk="Microsoft.NET.Sdk">

  <!-- Оболочка минимальной проверки переноса Q34: один шаг обучения с учителем
       и наблюдаемое доказательство, что обратный проход читает сохранённый
       знаменатель плавного вентиля. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Q34SingleStepRunner</AssemblyName>
    <RootNamespace>Q34SingleStepRunner</RootNamespace>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Оболочка не входит ни в одно решение продукта и собирается по пути. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Продуктовые проекты: изменённые плавный вентиль, сеть прямого
         распространения и блок трансформера приходят отсюда. -->
    <ProjectReference Include="..\..\..\..\..\00.TensorCore\TensorCore.csproj" />
    <ProjectReference Include="..\..\..\..\..\03.TransformerModel\TransformerModel.csproj" />
    <ProjectReference Include="..\..\..\..\..\04.TrainingLoop\TrainingLoop.csproj" />
    <ProjectReference Include="..\..\..\..\..\10.LoRA\LoRA.csproj" />
  </ItemGroup>

</Project>
