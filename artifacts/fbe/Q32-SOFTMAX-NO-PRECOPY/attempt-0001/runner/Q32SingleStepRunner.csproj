<Project Sdk="Microsoft.NET.Sdk">

  <!-- Оболочка минимальной проверки переноса Q32: нормализация внимания без
       предварительной копии входа в выходную память, и один обычный шаг
       обучения внимания на восстановленном обученном старте. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Q32SingleStepRunner</AssemblyName>
    <RootNamespace>Q32SingleStepRunner</RootNamespace>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Оболочка не входит ни в одно решение продукта и собирается по пути. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Продуктовые проекты: изменённое тензорное ядро, модель трансформера,
         цикл обучения и адаптеры низкого ранга приходят отсюда. -->
    <ProjectReference Include="..\..\..\..\..\00.TensorCore\TensorCore.csproj" />
    <ProjectReference Include="..\..\..\..\..\03.TransformerModel\TransformerModel.csproj" />
    <ProjectReference Include="..\..\..\..\..\04.TrainingLoop\TrainingLoop.csproj" />
    <ProjectReference Include="..\..\..\..\..\10.LoRA\LoRA.csproj" />
  </ItemGroup>

</Project>
