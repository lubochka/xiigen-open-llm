<Project Sdk="Microsoft.NET.Sdk">

  <!-- Оболочка минимальной проверки переноса: один шаг обучения с учителем. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Q35SingleStepRunner</AssemblyName>
    <RootNamespace>Q35SingleStepRunner</RootNamespace>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Оболочка не входит ни в одно решение продукта и собирается по пути. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Продуктовые проекты: изменённый обучающий цикл приходит отсюда. -->
    <ProjectReference Include="..\..\..\..\..\04.TrainingLoop\TrainingLoop.csproj" />
    <ProjectReference Include="..\..\..\..\..\14.ContinuousLearning\ContinuousLearning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тот же загрузчик принятого родителя, что в учебном примере опыта.
         Файл подключается только для чтения; замороженная попытка не меняется. -->
    <Compile Include="..\..\..\..\..\experiments-v2\RP01-MICRO\SEXP01\host\SftAcceptedParent.cs">
      <Link>SftAcceptedParent.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
