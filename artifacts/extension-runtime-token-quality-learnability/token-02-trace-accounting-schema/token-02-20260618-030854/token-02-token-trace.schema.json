{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "xiigen.token_02.token_trace.schema.v1",
    "title":  "TOKEN-02 token trace record schema",
    "type":  "object",
    "additionalProperties":  true,
    "required":  [
                     "pair_id",
                     "host",
                     "method",
                     "scenario_id",
                     "prompt_hash/ref",
                     "prompt_hash",
                     "prompt_ref",
                     "evidence_class/live_scope",
                     "evidence_class",
                     "live_scope",
                     "run_kind",
                     "target_locator_mode",
                     "target_locator_ref",
                     "tokenizer_accounting_version",
                     "redaction_policy",
                     "raw_private_trace_ref",
                     "redacted_trace_ref",
                     "input_text_ref_or_hash",
                     "output_text_ref_or_hash",
                     "input_token_count",
                     "output_token_count",
                     "total_token_count",
                     "token_counter_name",
                     "token_counter_version",
                     "token_counter_name/version",
                     "quality_non_regression_ref",
                     "no_external_ai_task_solving",
                     "no_training_started",
                     "no_model_mutation",
                     "claim_allowed"
                 ],
    "properties":  {
                       "pair_id":  {
                                       "type":  [
                                                    "string",
                                                    "integer",
                                                    "boolean",
                                                    "array",
                                                    "object",
                                                    "null"
                                                ]
                                   },
                       "host":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "Claude",
                                                 "Cursor",
                                                 "Codex"
                                             ]
                                },
                       "method":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "prompt-to-task",
                                                   "orchestration-plan",
                                                   "skill-selection"
                                               ]
                                  },
                       "scenario_id":  {
                                           "type":  [
                                                        "string",
                                                        "integer",
                                                        "boolean",
                                                        "array",
                                                        "object",
                                                        "null"
                                                    ]
                                       },
                       "prompt_hash/ref":  {
                                               "type":  [
                                                            "string",
                                                            "integer",
                                                            "boolean",
                                                            "array",
                                                            "object",
                                                            "null"
                                                        ]
                                           },
                       "prompt_hash":  {
                                           "type":  [
                                                        "string",
                                                        "integer",
                                                        "boolean",
                                                        "array",
                                                        "object",
                                                        "null"
                                                    ]
                                       },
                       "prompt_ref":  {
                                          "type":  [
                                                       "string",
                                                       "integer",
                                                       "boolean",
                                                       "array",
                                                       "object",
                                                       "null"
                                                   ]
                                      },
                       "evidence_class/live_scope":  {
                                                         "type":  [
                                                                      "string",
                                                                      "integer",
                                                                      "boolean",
                                                                      "array",
                                                                      "object",
                                                                      "null"
                                                                  ]
                                                     },
                       "evidence_class":  {
                                              "type":  [
                                                           "string",
                                                           "integer",
                                                           "boolean",
                                                           "array",
                                                           "object",
                                                           "null"
                                                       ]
                                          },
                       "live_scope":  {
                                          "type":  [
                                                       "string",
                                                       "integer",
                                                       "boolean",
                                                       "array",
                                                       "object",
                                                       "null"
                                                   ]
                                      },
                       "run_kind":  {
                                        "type":  "string",
                                        "enum":  [
                                                     "baseline",
                                                     "adaptive"
                                                 ]
                                    },
                       "target_locator_mode":  {
                                                   "type":  [
                                                                "string",
                                                                "integer",
                                                                "boolean",
                                                                "array",
                                                                "object",
                                                                "null"
                                                            ]
                                               },
                       "target_locator_ref":  {
                                                  "type":  [
                                                               "string",
                                                               "integer",
                                                               "boolean",
                                                               "array",
                                                               "object",
                                                               "null"
                                                           ]
                                              },
                       "tokenizer_accounting_version":  {
                                                            "type":  [
                                                                         "string",
                                                                         "integer",
                                                                         "boolean",
                                                                         "array",
                                                                         "object",
                                                                         "null"
                                                                     ]
                                                        },
                       "redaction_policy":  {
                                                "type":  [
                                                             "string",
                                                             "integer",
                                                             "boolean",
                                                             "array",
                                                             "object",
                                                             "null"
                                                         ]
                                            },
                       "raw_private_trace_ref":  {
                                                     "type":  [
                                                                  "string",
                                                                  "integer",
                                                                  "boolean",
                                                                  "array",
                                                                  "object",
                                                                  "null"
                                                              ]
                                                 },
                       "redacted_trace_ref":  {
                                                  "type":  [
                                                               "string",
                                                               "integer",
                                                               "boolean",
                                                               "array",
                                                               "object",
                                                               "null"
                                                           ]
                                              },
                       "input_text_ref_or_hash":  {
                                                      "type":  [
                                                                   "string",
                                                                   "integer",
                                                                   "boolean",
                                                                   "array",
                                                                   "object",
                                                                   "null"
                                                               ]
                                                  },
                       "output_text_ref_or_hash":  {
                                                       "type":  [
                                                                    "string",
                                                                    "integer",
                                                                    "boolean",
                                                                    "array",
                                                                    "object",
                                                                    "null"
                                                                ]
                                                   },
                       "input_token_count":  {
                                                 "type":  "integer",
                                                 "minimum":  0
                                             },
                       "output_token_count":  {
                                                  "type":  "integer",
                                                  "minimum":  0
                                              },
                       "total_token_count":  {
                                                 "type":  "integer",
                                                 "minimum":  0
                                             },
                       "token_counter_name":  {
                                                  "type":  [
                                                               "string",
                                                               "integer",
                                                               "boolean",
                                                               "array",
                                                               "object",
                                                               "null"
                                                           ]
                                              },
                       "token_counter_version":  {
                                                     "type":  [
                                                                  "string",
                                                                  "integer",
                                                                  "boolean",
                                                                  "array",
                                                                  "object",
                                                                  "null"
                                                              ]
                                                 },
                       "token_counter_name/version":  {
                                                          "type":  [
                                                                       "string",
                                                                       "integer",
                                                                       "boolean",
                                                                       "array",
                                                                       "object",
                                                                       "null"
                                                                   ]
                                                      },
                       "quality_non_regression_ref":  {
                                                          "type":  [
                                                                       "string",
                                                                       "integer",
                                                                       "boolean",
                                                                       "array",
                                                                       "object",
                                                                       "null"
                                                                   ]
                                                      },
                       "no_external_ai_task_solving":  {
                                                           "type":  "boolean",
                                                           "const":  true
                                                       },
                       "no_training_started":  {
                                                   "type":  "boolean",
                                                   "const":  true
                                               },
                       "no_model_mutation":  {
                                                 "type":  "boolean",
                                                 "const":  true
                                             },
                       "claim_allowed":  {
                                             "type":  "boolean",
                                             "const":  false
                                         }
                   }
}