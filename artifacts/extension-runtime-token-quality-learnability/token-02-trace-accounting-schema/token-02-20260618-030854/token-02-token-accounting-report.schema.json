{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "xiigen.token_02.token_accounting_report.schema.v1",
    "title":  "TOKEN-02 token accounting report schema",
    "type":  "object",
    "additionalProperties":  true,
    "required":  [
                     "accounting_report_id",
                     "pair_id",
                     "host",
                     "method",
                     "scenario_id",
                     "prompt_hash/ref",
                     "evidence_class/live_scope",
                     "tokenizer_accounting_version",
                     "token_counter_name",
                     "token_counter_version",
                     "baseline_trace_ref",
                     "adaptive_trace_ref",
                     "baseline_total_token_count",
                     "adaptive_total_token_count",
                     "delta_total_token_count",
                     "quality_non_regression_ref",
                     "pairing_integrity_status",
                     "failure_labels",
                     "claim_allowed",
                     "no_external_ai_task_solving",
                     "no_training_started",
                     "no_model_mutation"
                 ],
    "properties":  {
                       "accounting_report_id":  {
                                                    "type":  [
                                                                 "string",
                                                                 "integer",
                                                                 "boolean",
                                                                 "array",
                                                                 "object",
                                                                 "null"
                                                             ]
                                                },
                       "pair_id":  {
                                       "type":  [
                                                    "string",
                                                    "integer",
                                                    "boolean",
                                                    "array",
                                                    "object",
                                                    "null"
                                                ]
                                   },
                       "host":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "Claude",
                                                 "Cursor",
                                                 "Codex"
                                             ]
                                },
                       "method":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "prompt-to-task",
                                                   "orchestration-plan",
                                                   "skill-selection"
                                               ]
                                  },
                       "scenario_id":  {
                                           "type":  [
                                                        "string",
                                                        "integer",
                                                        "boolean",
                                                        "array",
                                                        "object",
                                                        "null"
                                                    ]
                                       },
                       "prompt_hash/ref":  {
                                               "type":  [
                                                            "string",
                                                            "integer",
                                                            "boolean",
                                                            "array",
                                                            "object",
                                                            "null"
                                                        ]
                                           },
                       "evidence_class/live_scope":  {
                                                         "type":  [
                                                                      "string",
                                                                      "integer",
                                                                      "boolean",
                                                                      "array",
                                                                      "object",
                                                                      "null"
                                                                  ]
                                                     },
                       "tokenizer_accounting_version":  {
                                                            "type":  [
                                                                         "string",
                                                                         "integer",
                                                                         "boolean",
                                                                         "array",
                                                                         "object",
                                                                         "null"
                                                                     ]
                                                        },
                       "token_counter_name":  {
                                                  "type":  [
                                                               "string",
                                                               "integer",
                                                               "boolean",
                                                               "array",
                                                               "object",
                                                               "null"
                                                           ]
                                              },
                       "token_counter_version":  {
                                                     "type":  [
                                                                  "string",
                                                                  "integer",
                                                                  "boolean",
                                                                  "array",
                                                                  "object",
                                                                  "null"
                                                              ]
                                                 },
                       "baseline_trace_ref":  {
                                                  "type":  [
                                                               "string",
                                                               "integer",
                                                               "boolean",
                                                               "array",
                                                               "object",
                                                               "null"
                                                           ]
                                              },
                       "adaptive_trace_ref":  {
                                                  "type":  [
                                                               "string",
                                                               "integer",
                                                               "boolean",
                                                               "array",
                                                               "object",
                                                               "null"
                                                           ]
                                              },
                       "baseline_total_token_count":  {
                                                          "type":  [
                                                                       "integer",
                                                                       "null"
                                                                   ],
                                                          "minimum":  0
                                                      },
                       "adaptive_total_token_count":  {
                                                          "type":  [
                                                                       "integer",
                                                                       "null"
                                                                   ],
                                                          "minimum":  0
                                                      },
                       "delta_total_token_count":  {
                                                       "type":  [
                                                                    "integer",
                                                                    "null"
                                                                ]
                                                   },
                       "quality_non_regression_ref":  {
                                                          "type":  [
                                                                       "string",
                                                                       "integer",
                                                                       "boolean",
                                                                       "array",
                                                                       "object",
                                                                       "null"
                                                                   ]
                                                      },
                       "pairing_integrity_status":  {
                                                        "type":  "string",
                                                        "enum":  [
                                                                     "VALID_PAIR_QUALITY_PENDING",
                                                                     "VALID_PAIR_QUALITY_PASSED",
                                                                     "INVALID_PAIR",
                                                                     "MISSING_TRACE_NOT_A_SAVINGS_FAILURE_YET"
                                                                 ]
                                                    },
                       "failure_labels":  {
                                              "type":  [
                                                           "string",
                                                           "integer",
                                                           "boolean",
                                                           "array",
                                                           "object",
                                                           "null"
                                                       ]
                                          },
                       "claim_allowed":  {
                                             "type":  "boolean",
                                             "const":  false
                                         },
                       "no_external_ai_task_solving":  {
                                                           "type":  "boolean",
                                                           "const":  true
                                                       },
                       "no_training_started":  {
                                                   "type":  "boolean",
                                                   "const":  true
                                               },
                       "no_model_mutation":  {
                                                 "type":  "boolean",
                                                 "const":  true
                                             }
                   }
}