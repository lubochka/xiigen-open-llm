{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "XIIGen advanced wiki question suite",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "generated_at_utc",
                     "validation_only",
                     "questions",
                     "gate"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "type":  "string"
                                          },
                       "generated_at_utc":  {
                                                "type":  "string"
                                            },
                       "validation_only":  {
                                               "type":  "boolean"
                                           },
                       "questions":  {
                                         "type":  "array",
                                         "items":  {
                                                       "type":  "object",
                                                       "required":  [
                                                                        "question_id",
                                                                        "question_class",
                                                                        "underlying_question_class",
                                                                        "prompt_variation",
                                                                        "required_evidence_types",
                                                                        "expected_query_steps",
                                                                        "expected_answer_sections",
                                                                        "required_units",
                                                                        "pass_thresholds"
                                                                    ],
                                                       "properties":  {
                                                                          "question_id":  {
                                                                                              "type":  "string"
                                                                                          },
                                                                          "question_class":  {
                                                                                                 "type":  "string"
                                                                                             },
                                                                          "underlying_question_class":  {
                                                                                                            "type":  "string",
                                                                                                            "enum":  [
                                                                                                                         "field_addition_impact",
                                                                                                                         "field_rename_impact",
                                                                                                                         "dto_contract_change",
                                                                                                                         "api_response_shape_change",
                                                                                                                         "client_state_effect",
                                                                                                                         "cross_repo_workflow_trace",
                                                                                                                         "authorization_rule_change",
                                                                                                                         "stored_procedure_parameter_change",
                                                                                                                         "stored_procedure_result_shape_change",
                                                                                                                         "calculation_path_change",
                                                                                                                         "validation_rule_change",
                                                                                                                         "missing_evidence_abstention",
                                                                                                                         "wrong_project_rejection",
                                                                                                                         "stale_documentation_rejection"
                                                                                                                     ]
                                                                                                        },
                                                                          "prompt_variation":  {
                                                                                                   "type":  "string"
                                                                                               }
                                                                      }
                                                   }
                                     },
                       "gate":  {
                                    "type":  "object",
                                    "required":  [
                                                     "required_total_questions",
                                                     "actual_total_questions",
                                                     "required_classes",
                                                     "actual_classes",
                                                     "required_underlying_question_classes",
                                                     "actual_underlying_question_classes",
                                                     "underlying_question_class_set_passed",
                                                     "passed"
                                                 ]
                                }
                   }
}
