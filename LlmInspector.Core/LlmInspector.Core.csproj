<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The inspector data layer is UI-neutral so tests and the WPF shell can reference the same contracts. -->
    <TargetFramework>net9.0</TargetFramework>
    <!-- Keep the shared inspector data layer aligned with the repository defaults. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keep the namespace stable for the later WPF panels and tracing decorators. -->
    <RootNamespace>LlmInspector</RootNamespace>
    <AssemblyName>LlmInspector.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tracing decorators observe the real logical contracts from the runtime layer. -->
    <ProjectReference Include="..\21.AgentInfrastructure\AgentInfrastructure.csproj" />
    <!-- Project 22 stations are inspected through lightweight adapters over the real algorithms. -->
    <ProjectReference Include="..\22.AgentAlgorithms\AgentAlgorithms.csproj" />
    <!-- AgentAlgorithms domain labels use the canonical project-29 enum. -->
    <ProjectReference Include="..\29.SemanticCompiler\SemanticCompiler.csproj" />
    <!-- Project 23 stations are inspected through lightweight adapters over the real OSS-equivalent runtime. -->
    <ProjectReference Include="..\23.OssEquivalents\OssEquivalents.csproj" />
  </ItemGroup>

</Project>
