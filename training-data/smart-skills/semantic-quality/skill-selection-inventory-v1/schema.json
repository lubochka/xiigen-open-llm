{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "skill-selection-inventory-v1.schema.json",
    "title":  "SkillSelection semantic inventory row v1",
    "type":  "object",
    "additionalProperties":  true,
    "required":  [
                     "schema_version",
                     "machine_target",
                     "inventory_version",
                     "skill_id",
                     "source_path",
                     "source_sha256",
                     "name_title",
                     "purpose",
                     "trigger_summary",
                     "inputs",
                     "outputs",
                     "when_not_to_use",
                     "compatible_skills",
                     "conflicting_skills",
                     "universal_semantics",
                     "repo_specific_technical_details",
                     "source_quality",
                     "candidate_position_authority",
                     "training_allowed",
                     "semantic_quality_claimed",
                     "raw_private_text_copied",
                     "no_raw_private_text_marker"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1,
                                              "type":  "integer"
                                          },
                       "machine_target":  {
                                              "const":  "SkillSelectionMachine",
                                              "type":  "string"
                                          },
                       "skill_id":  {
                                        "minLength":  1,
                                        "type":  "string"
                                    },
                       "source_path":  {
                                           "type":  "string",
                                           "pattern":  "^docs/skills/.+\\.md$"
                                       },
                       "source_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^[a-f0-9]{64}$"
                                         },
                       "source_quality":  {
                                              "type":  "string",
                                              "enum":  [
                                                           "gold",
                                                           "silver",
                                                           "rejected"
                                                       ]
                                          },
                       "candidate_position_authority":  {
                                                            "const":  false,
                                                            "type":  "boolean"
                                                        },
                       "training_allowed":  {
                                                "const":  false,
                                                "type":  "boolean"
                                            },
                       "semantic_quality_claimed":  {
                                                        "const":  false,
                                                        "type":  "boolean"
                                                    },
                       "raw_private_text_copied":  {
                                                       "const":  false,
                                                       "type":  "boolean"
                                                   }
                   }
}
