{
  "policy_id": "user-local-adaptive-startup-redaction-policy-v1",
  "schema_version": "1.0.0",
  "scope": "Q6-01 startup material intake definition only",
  "raw_private_text_committed": false,
  "default_storage": "user_local_profile_only",
  "allowed_source_kinds": [
    "agents_md",
    "claude_md",
    "skill_file"
  ],
  "allowed_committed_fields": [
    "source_id",
    "source_kind",
    "source_path_redacted",
    "source_path_hash",
    "source_sha256",
    "project_root_hash",
    "capture_timestamp_utc",
    "no_raw_text",
    "raw_private_text_committed",
    "adaptive_ref_id",
    "dpo_candidate_ref_id",
    "domain",
    "target_leg",
    "chosen_ref",
    "rejected_ref",
    "common_checkpoint_hash_before",
    "common_checkpoint_hash_after"
  ],
  "forbidden_committed_fields": [
    "raw_source_text",
    "raw_prompt",
    "raw_answer",
    "raw_correction",
    "raw_skill_body",
    "unredacted_absolute_path",
    "secret",
    "credential",
    "token",
    "api_key"
  ],
  "path_policy": {
    "commit_absolute_paths": false,
    "commit_redacted_paths": true,
    "redacted_project_root_label": "<project-root>",
    "hash_absolute_paths_before_storage": true
  },
  "text_policy": {
    "commit_raw_private_text": false,
    "commit_synthetic_examples_only": true,
    "store_private_text_only_in_user_local_profile_when_explicitly_allowed": true,
    "common_training_rows_may_reference_private_material_by_hash_only": true
  },
  "output_policy": {
    "common_model_rows_created": false,
    "common_training_rows_created": false,
    "user_local_adaptive_refs_created": true,
    "dpo_candidate_refs_created": true,
    "training_allowed_in_q6_01": false
  },
  "q6_05_later_hooks": {
    "backup": "reference hook only; not implemented in Q6-01",
    "export": "reference hook only; not implemented in Q6-01",
    "import": "reference hook only; not implemented in Q6-01",
    "share": "reference hook only; not implemented in Q6-01"
  }
}
