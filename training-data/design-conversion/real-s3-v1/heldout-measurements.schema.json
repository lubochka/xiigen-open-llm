{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-mvp-core.local/schemas/design-conversion/real-s3-v1/heldout-measurements.schema.json",
  "title": "DesignConversion real S3 held-out measurement",
  "description": "Schema for real held-out measurement evidence aligned with DesignConversionMeasurementGate.",
  "type": "object",
  "additionalProperties": false,
  "x_scaffold_status": {
    "placeholder_not_real": true,
    "evidence_status": "schema_only_not_real_evidence"
  },
  "$comment": "placeholder_not_real=true; schema-only scaffold, not a real held-out result.",
  "required": [
    "schema_version",
    "measurement_id",
    "dataset_id",
    "unit_id",
    "checkpoint_ref",
    "measurement_gate_status",
    "held_out_metrics",
    "integrity_proof",
    "thresholds",
    "runtime_cost",
    "evidence_status",
    "promotion_upload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "measurement_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 1
    },
    "measurement_gate_status": {
      "type": "string",
      "enum": [
        "not_run",
        "failed",
        "passed"
      ]
    },
    "held_out_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "held_out_record_count",
        "held_out_quality_score",
        "required_held_out_quality_score",
        "runtime_ms",
        "cost_usd",
        "peak_ram_mb",
        "evidence_refs"
      ],
      "properties": {
        "held_out_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "held_out_quality_score": {
          "$ref": "#/$defs/score"
        },
        "required_held_out_quality_score": {
          "$ref": "#/$defs/score"
        },
        "runtime_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "peak_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "integrity_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_disjoint",
        "leakage_detected",
        "hidden_determinism_detected",
        "ablation_passed",
        "anti_leakage_evidence_refs",
        "ablation_evidence_refs"
      ],
      "properties": {
        "source_disjoint": {
          "type": "boolean"
        },
        "leakage_detected": {
          "type": "boolean",
          "const": false
        },
        "hidden_determinism_detected": {
          "type": "boolean",
          "const": false
        },
        "ablation_passed": {
          "type": "boolean"
        },
        "anti_leakage_evidence_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "ablation_evidence_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_held_out_quality_score",
        "max_runtime_ms",
        "max_cost_usd",
        "max_peak_ram_mb"
      ],
      "properties": {
        "required_held_out_quality_score": {
          "$ref": "#/$defs/score"
        },
        "max_runtime_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_peak_ram_mb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runtime_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_ms",
        "cost_usd",
        "peak_ram_mb",
        "budget_passed"
      ],
      "properties": {
        "runtime_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "peak_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "budget_passed": {
          "type": "boolean"
        }
      }
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "real_held_out_measurement_ready",
        "placeholder_not_real"
      ]
    },
    "promotion_upload": {
      "type": "string",
      "enum": [
        "blocked",
        "not_attempted"
      ]
    }
  },
  "$defs": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
