{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-mvp-core.local/schemas/design-conversion/real-s3-v1/checkpoint-manifest.schema.json",
  "title": "DesignConversion real S3 checkpoint manifest",
  "description": "Schema for real checkpoint, weights, fresh-load, and continue-training manifest evidence.",
  "type": "object",
  "additionalProperties": false,
  "x_scaffold_status": {
    "placeholder_not_real": true,
    "evidence_status": "schema_only_not_real_evidence"
  },
  "$comment": "placeholder_not_real=true; schema-only scaffold, not real trained weights.",
  "required": [
    "schema_version",
    "checkpoint_ref",
    "checkpoint_sha256",
    "domain_tag",
    "machine_id",
    "version",
    "exported_utc",
    "checkpoint_contains_real_trained_weights",
    "weights",
    "fresh_load_probe",
    "continue_training_probe",
    "training_dataset_id",
    "train_row_count",
    "held_out_row_count",
    "measurement_gate_refs",
    "promotion_upload",
    "evidence_status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Bundle-local or redacted checkpoint ref only."
    },
    "checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "domain_tag": {
      "type": "string",
      "const": "DesignConversionDomain"
    },
    "machine_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "exported_utc": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint_contains_real_trained_weights": {
      "type": "boolean"
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights_ref",
        "weights_sha256",
        "learned_weights_present",
        "unit_manifests",
        "raw_model_upload_performed"
      ],
      "properties": {
        "weights_ref": {
          "type": "string",
          "minLength": 1
        },
        "weights_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "learned_weights_present": {
          "type": "boolean"
        },
        "unit_manifests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "unit_role",
              "implementation_status",
              "learned_weights_present",
              "evidence_refs"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "unit_role": {
                "type": "string",
                "minLength": 1
              },
              "implementation_status": {
                "type": "string",
                "minLength": 1
              },
              "learned_weights_present": {
                "type": "boolean"
              },
              "evidence_refs": {
                "$ref": "#/$defs/nonEmptyStringArray"
              }
            }
          }
        },
        "raw_model_upload_performed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "fresh_load_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_load_performed",
        "loaded_checkpoint_sha256",
        "metadata_continuity_passed",
        "checkpoint_contains_real_trained_weights",
        "evidence_refs"
      ],
      "properties": {
        "fresh_load_performed": {
          "type": "boolean"
        },
        "loaded_checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metadata_continuity_passed": {
          "type": "boolean"
        },
        "checkpoint_contains_real_trained_weights": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "continue_training_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continue_training_performed",
        "real_trained_weights_continued",
        "train_rows_used",
        "held_out_rows_used",
        "measurement_gate_run",
        "evidence_refs"
      ],
      "properties": {
        "continue_training_performed": {
          "type": "boolean"
        },
        "real_trained_weights_continued": {
          "type": "boolean"
        },
        "train_rows_used": {
          "type": "integer",
          "minimum": 0
        },
        "held_out_rows_used": {
          "type": "integer",
          "const": 0
        },
        "measurement_gate_run": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "training_dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "train_row_count": {
      "type": "integer",
      "minimum": 1
    },
    "held_out_row_count": {
      "type": "integer",
      "minimum": 1
    },
    "measurement_gate_refs": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "promotion_upload": {
      "type": "string",
      "enum": [
        "blocked",
        "not_attempted"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "real_checkpoint_manifest_ready",
        "placeholder_not_real"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
