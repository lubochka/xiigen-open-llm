<UserControl x:Class="LlmInspector.Views.StationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LlmInspector.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,2">
        <Border Margin="2,3,2,1"
                Padding="10,8"
                Background="{StaticResource BrushCardHot}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,1,1,1"
                CornerRadius="6"
                Cursor="Hand"
                MouseLeftButtonDown="Card_Clicked">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="8"
                         Height="8"
                         Fill="{StaticResource BrushAccent}"
                         Margin="0,5,8,0"
                         VerticalAlignment="Top" />

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,3">
                        <Border Style="{StaticResource StationTypeBadge}">
                            <TextBlock Text="{Binding StationTypeText}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}" />
                        </Border>
                        <TextBlock Text="{Binding StationName}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StationRole}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10"
                               Foreground="{StaticResource BrushInfo}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Summary}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextTertiary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ResourceText}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="9"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top">
                    <TextBlock Text="RUNTIME"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="8"
                               Foreground="{StaticResource BrushTextTertiary}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding DurationText}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAmber}"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding WaveGroups}"
                      Margin="16,0,0,0"
                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisible}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:StationCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
