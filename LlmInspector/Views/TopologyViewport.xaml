<UserControl x:Class="LlmInspector.Views.TopologyViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanelInner}">
    <Border Style="{StaticResource EmptyPanel}">
        <Grid>
            <Canvas x:Name="Surface"
                    Background="{StaticResource BrushPanelInner}"
                    ClipToBounds="True" />

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12"
                    Padding="8"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <Button Content="OVERVIEW"
                            Style="{StaticResource ViewportToolButton}"
                            Click="Overview_Click" />
                    <Button Content="OPEN ACTIVE"
                            Style="{StaticResource ViewportToolButton}"
                            Click="OpenActive_Click" />
                    <Button Content="FIT"
                            Style="{StaticResource ViewportToolButton}"
                            Click="Fit_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
