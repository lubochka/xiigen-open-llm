<UserControl x:Class="LlmInspector.Views.StationInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LlmInspector.Views"
             Background="{StaticResource BrushPanelInner}">
    <Border Style="{StaticResource EmptyPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding StationName, TargetNullValue=idle}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0,0,0,2" />
                <TextBlock Text="{Binding StationRole}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="10"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Border Style="{StaticResource StationTypeBadge}">
                        <TextBlock Text="{Binding StationTypeText}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}" />
                    </Border>
                    <TextBlock Text="{Binding DurationText}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10"
                               Foreground="{StaticResource BrushAmber}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ResourceText}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="INPUT"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="10"
                           Foreground="{StaticResource BrushTextTertiary}"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Input}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:PropertyNodeView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12,0,12"
                           Background="{StaticResource BrushBorder}" />

                <TextBlock Text="OUTPUT"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="10"
                           Foreground="{StaticResource BrushTextTertiary}"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Output}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:PropertyNodeView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
