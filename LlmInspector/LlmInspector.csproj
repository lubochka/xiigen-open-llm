<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The inspector is a Windows desktop shell, so it targets the Windows-specific .NET TFM. -->
    <OutputType>WinExe</OutputType>
    <!-- The repository is on .NET 9, so the shell follows the existing project target family. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- WPF is required for the XAML shell and the lightweight topology viewport. -->
    <UseWPF>true</UseWPF>
    <!-- Keep the project aligned with the nullable and implicit-using defaults used by the repo. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Use a stable namespace that is independent from the numbered project folders. -->
    <RootNamespace>LlmInspector</RootNamespace>
    <AssemblyName>LlmInspector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the UI-neutral inspector contracts that later panels and tracing decorators will bind to. -->
    <ProjectReference Include="..\LlmInspector.Core\LlmInspector.Core.csproj" />
    <!-- Keep the shell beside the logical runtime contracts it will inspect in later phases. -->
    <ProjectReference Include="..\21.AgentInfrastructure\AgentInfrastructure.csproj" />
  </ItemGroup>

</Project>
