<RunSettings>
  <RunConfiguration>
    <TestSessionTimeout>480000</TestSessionTimeout>
    <TestCaseFilter>FullyQualifiedName=LlmFromScratch.Tests.ServerOwnedLogicalCapabilityReplayVerificationCompositionTests.EnvironmentConfiguration_AbsentOrMalformed_FailsClosed|FullyQualifiedName=LlmFromScratch.Tests.ServerOwnedLogicalCapabilityReplayVerificationCompositionTests.CanonicalEnvironmentHmac_VerifiesExactReplayAttestation|FullyQualifiedName=LlmFromScratch.Tests.ServerOwnedLogicalCapabilityReplayVerificationCompositionTests.CanonicalEnvironmentHmac_VerifiesExactExecutableManifestBinding</TestCaseFilter>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame">
        <Configuration>
          <CollectDumpOnTestSessionHang TestTimeout="5m" HangDumpType="None" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
