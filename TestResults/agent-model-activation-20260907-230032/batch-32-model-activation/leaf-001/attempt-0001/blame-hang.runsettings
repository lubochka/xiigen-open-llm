<RunSettings>
  <RunConfiguration>
    <TestSessionTimeout>480000</TestSessionTimeout>
    <TestCaseFilter>FullyQualifiedName=DesignConversionActivatedModelRepositoryHostRuntimeTests.RepositoryPromotionHostEvaluate_LoadsActiveCheckpointThroughRepositoryInsteadOfCorruptLocalPath|FullyQualifiedName=DesignConversionActivatedModelRepositoryHostRuntimeTests.RepositoryPromotionHostEvaluate_FailedConcurrentLoadPreservesRepositoryRuntimeWithoutFreshEvidence|FullyQualifiedName=DesignConversionExternalVisualAiReceiptTrustTests.ExternalVisualAiComparison_RealLoopbackHttpReceipt_CanonicalizesTrustedThroughInternalService|FullyQualifiedName=DesignConversionExternalVisualAiReceiptTrustTests.ExternalVisualAiComparison_InvalidReceiptMutation_IsUntrustedZeroedAndEvidenceBound|FullyQualifiedName=DesignConversionExternalVisualAiReceiptTrustTests.ExternalVisualAiComparison_InjectedForgedJudgeReceipt_RemainsUntrustedAndZeroedThroughInternalService</TestCaseFilter>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="blame">
        <Configuration>
          <CollectDumpOnTestSessionHang TestTimeout="5m" HangDumpType="None" />
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
